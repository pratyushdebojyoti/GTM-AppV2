rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Role-Based Access Control Functions
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'ADMIN' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().role == 'ADMIN'));
    }

    function isClient() {
      return isAuthenticated() &&
        (request.auth.token.role == 'CLIENT' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().role == 'CLIENT'));
    }

    // =========================================================================
    // 1. Users Collection
    // Clients & public users can access only their own user document.
    // Admins have supervisory oversight.
    // =========================================================================
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && (request.resource.data.role != 'ADMIN' || isAdmin());
      allow update: if (isUser(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Clients Collection
    // Organization records. Clients read only their own profile.
    // =========================================================================
    match /clients/{clientId} {
      allow read: if (isAuthenticated() && (request.auth.uid == clientId || resource.data.userId == request.auth.uid)) || isAdmin();
      allow create: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
      allow update: if (isAuthenticated() && (request.auth.uid == clientId || resource.data.userId == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. Leads Collection (Quotes, Prospective inquiries, Contact submissions)
    // Anyone (even prospective clients prior to authentication) can submit inquiries.
    // Only the author or Admins can read or triage submitted leads.
    // =========================================================================
    match /leads/{leadId} {
      allow create: if true;
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 4. Projects Collection & Sub-collections (Milestones, Documents)
    // Strict multi-tenant isolation: clients cannot see other enterprise projects.
    // Clients MUST NOT be able to modify project status, progress, or assigned team.
    // All modifications to projects and milestones require ADMIN privileges.
    // Clients have strictly read-only access to their own projects, milestones, and documents.
    // =========================================================================
    match /projects/{projectId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.clientId == request.auth.uid)) || isAdmin();
      // Clients are strictly forbidden from creating, updating, or deleting projects
      // This enforces that project status, progress percentage, assigned team, and timeline are server/admin-controlled.
      allow create, update, delete: if isAdmin();

      match /milestones/{milestoneId} {
        allow read: if (isAuthenticated() && (get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
                                             get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid)) || isAdmin();
        // Milestones can only be authored and updated by Admins
        allow write: if isAdmin();
      }

      match /documents/{documentId} {
        allow read: if (isAuthenticated() && (get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
                                             get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid)) || isAdmin();
        // Client can upload an approved document if authenticated as owner of project, but cannot tamper with deliverables
        allow create: if (isAuthenticated() && (get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
                                               get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid)) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // =========================================================================
    // 5. Public Agency Catalog (Services, Portfolio, Testimonials)
    // Publicly accessible for read; immutable to non-admins.
    // =========================================================================
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. Notifications Collection
    // Users can read only notifications targeted to their user ID or broadcast "ALL".
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if (isAuthenticated() && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == 'ALL')) || isAdmin();
      allow update: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create, delete: if isAdmin();
    }

    // =========================================================================
    // 7. Messages Collection (Realtime Project Communications)
    // =========================================================================
    match /messages/{messageId} {
      allow read: if (isAuthenticated() && (resource.data.senderId == request.auth.uid || request.auth.uid in resource.data.readBy)) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (request.auth.uid in request.resource.data.readBy || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 8. Support Tickets Collection
    // Enterprise ticketing with client-level isolation.
    // =========================================================================
    match /supportTickets/{ticketId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 9. Agency Settings
    // Public configuration reads; Admin updates.
    // =========================================================================
    match /agencySettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 10. Activity Audit Logs
    // Append-only for authenticated actions; Admin read only.
    // =========================================================================
    match /activityLogs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}
